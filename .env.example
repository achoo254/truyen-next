# apps/server env. Copy to apps/server/.env for dev; production keeps its own file on the server, written by
# infra/setup-sign-in.sh (never in git). Reading never needs the API; it only keeps a signed-in reader's shelf,
# progress and history.
# NODE_ENV=production on the server; development by default.
NODE_ENV=development
# Loopback port of the API (production and dev: 5300; the web dev server on 5301 proxies /api, /auth and /healthz).
PORT=5300
# Public origin of the site; the sign-in callback is PUBLIC_URL/auth/callback. Dev: the web dev server.
PUBLIC_URL=http://localhost:5301
# Postgres connection string. Unset: embedded PGlite under .data/pglite (dev only; refused in production).
DATABASE_URL=
# hoandat.com account (auth-next). Sign-in stays off until AUTH_CLIENT_SECRET is set.
AUTH_ISSUER=https://auth.hoandat.com
AUTH_CLIENT_ID=truyen-web
# Secret of the confidential client truyen-web (the IdP's TRUYEN_WEB_CLIENT_SECRET). At least 32 characters.
AUTH_CLIENT_SECRET=
