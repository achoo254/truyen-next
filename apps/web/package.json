{
  "name": "@truyen/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 5301 --strictPort",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview --port 5301 --strictPort",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p e2e/tsconfig.json",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "build:native": "tsc --noEmit -p tsconfig.json && vite build --mode native"
  },
  "dependencies": {
    "@achoo254/app-shell": "github:achoo254/shared-next#v0.12.0&path:/packages/app-shell",
    "@achoo254/brand": "github:achoo254/shared-next#v0.12.0&path:/packages/brand",
    "@capacitor/core": "8.5.3",
    "@capacitor/file-transfer": "2.0.6",
    "@capacitor/filesystem": "8.1.5",
    "@fontsource/alegreya": "^5.3.0",
    "@fontsource/alegreya-sans": "^5.3.0",
    "@truyen/story": "workspace:*",
    "page-flip": "2.0.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.1",
    "vite": "^8.3.1"
  }
}
